<?xml version="1.0"?>
<!-- Gazebo（Classic）に置く赤いボール。半径 0.1 m。 -->
<sdf version="1.6">
  <model name="red_ball">
    <link name="link">
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0004</ixx><iyy>0.0004</iyy><izz>0.0004</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><sphere><radius>0.1</radius></sphere></geometry>
      </collision>
      <visual name="visual">
        <geometry><sphere><radius>0.1</radius></sphere></geometry>
        <material>
          <ambient>1 0 0 1</ambient>
          <diffuse>1 0 0 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
          <emissive>0.2 0 0 1</emissive>
        </material>
      </visual>
    </link>
  </model>
</sdf>
